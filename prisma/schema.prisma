generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  songs     Song[]
  createdAt DateTime @default(now())
}

model Song {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  youtubeId      String
  practiceLevel  String   @default("A2")
  difficultyNote String?
  artistId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  artist          Artist            @relation(fields: [artistId], references: [id])
  lyrics          SongLyrics?
  savedVocabulary SavedVocabulary[]
}

model SongLyrics {
  id            String   @id @default(cuid())
  songId        String   @unique
  lrcContent    String   @db.Text
  syncedVideoId String
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
}

model VocabularyExplanation {
  id String @id @default(cuid())

  cacheKey String @unique @db.VarChar(64)

  word    String @db.VarChar(100)
  context String @db.Text
  level   String @db.VarChar(5)

  modelId       String
  promptVersion Int    @default(1)

  explanation     Json
  savedVocabulary SavedVocabulary[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedVocabulary {
  id            String   @id @default(cuid())
  songId        String
  explanationId String
  createdAt     DateTime @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  explanation VocabularyExplanation @relation(fields: [explanationId], references: [id], onDelete: Cascade)

  @@unique([songId, explanationId])
  @@index([explanationId])
}
